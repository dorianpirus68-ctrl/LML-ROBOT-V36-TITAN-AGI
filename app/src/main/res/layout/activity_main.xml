<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/nexus_void"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LML // AGENT LOCAL" android:textColor="@color/nexus_cyan" android:textSize="12sp" android:letterSpacing="0.16" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="NEXUS / CENTRE DE MISSION" android:textColor="@color/nexus_text" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="PROPOSER  ·  VÉRIFIER  ·  AUTORISER  ·  EXÉCUTER" android:textColor="@color/nexus_muted" android:textSize="10sp" android:letterSpacing="0.07" />
        <com.lml.control.HoloCoreView android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/nexus_panel" android:padding="14dp" android:text="@string/status_off" android:textColor="@color/nexus_cyan" android:textStyle="bold" />
        <TextView android:id="@+id/model_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/nexus_panel_amber" android:padding="12dp" android:textColor="@color/nexus_amber" android:textSize="14sp" />
        <Button android:id="@+id/model_manager" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/model_manager" />
        <Button android:id="@+id/mission_control" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/nexus_button_primary" android:text="@string/mission_control" android:textColor="@color/nexus_void" />
        <TextView android:id="@+id/permissions_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/nexus_panel" android:padding="12dp" android:textColor="@color/nexus_text" />
        <Button android:id="@+id/permission_center" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/permission_center_title" />
        <Button android:id="@+id/toggle_bubble" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bubble_start" />
        <Button android:id="@+id/toggle_assistant" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/toggle_on" />
        <TextView android:id="@+id/capability_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/nexus_panel" android:padding="12dp" android:textColor="@color/nexus_text" />
        <Button android:id="@+id/allowed_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/allowed_apps_title" />
        <Button android:id="@+id/training" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/training_title" />
        <Button android:id="@+id/chat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/chat_title" />
        <Button android:id="@+id/approved_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/approved_actions_title" />
        <TextView android:id="@+id/session_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/nexus_panel" android:padding="12dp" android:textColor="@color/nexus_text" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/recent_activity" android:textColor="@color/nexus_cyan" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/activity_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/nexus_panel" android:minHeight="76dp" android:padding="12dp" android:textColor="@color/nexus_text" />
        <Button android:id="@+id/history_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_title" />
        <Button android:id="@+id/copy_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/copy_summary" />
        <Button android:id="@+id/assistant_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/assistant_title" />
        <Button android:id="@+id/safety_info" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/safety_title" />
        <Button android:id="@+id/reset_data" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/reset_data" />
    </LinearLayout>
</ScrollView>
